# Environment Variables Template for College Discovery Production & Local Dev

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================

# 1. DATABASE_URL:
# Used by Next.js application queries.
# In production with serverless databases (Neon, Supabase, AWS RDS + PgBouncer),
# this MUST be the Connection Pooled URL (port 6543 for Supabase, pooler URL for Neon).
DATABASE_URL="postgresql://user:password@pooler.example.com:6543/college_discovery?pgbouncer=true"

# 2. DIRECT_URL:
# Used by Prisma Migrations (`prisma migrate deploy`).
# This MUST be the Direct, Unpooled Database Connection (port 5432).
DIRECT_URL="postgresql://user:password@db.example.com:5432/college_discovery"

# ==========================================
# AUTHENTICATION & EXTERNAL SERVICES
# ==========================================
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="https://yourdomain.com" # or http://localhost:3000 in dev

NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
